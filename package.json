{
  "name": "dsh-composer-input-history",
  "version": "0.1.2",
  "type": "module",
  "description": "Shell-style input history for the DSH composer: ArrowUp recalls messages you already sent, ArrowDown walks forward, restores your draft, and a further press discards it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liumorrisclaw/dsh-composer-input-history.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "composer",
    "input-history",
    "history"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/history.test.mjs tests/composer-sim.test.mjs",
    "prepublishOnly": "node --test tests/history.test.mjs tests/composer-sim.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
